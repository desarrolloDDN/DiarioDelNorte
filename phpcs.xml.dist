<?xml version="1.0"?>
<ruleset name="Diario del Norte">
	<description>Estándar de codificación para el tema y la suite de Diario del Norte.</description>

	<file>theme</file>
	<file>plugin</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/dist/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Los avisos se muestran pero no rompen la build (cachés de consulta,
	     nombres de parámetro, etc. quedan como recordatorio). -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="diario-del-norte"/>
				<element value="ddn-suite"/>
			</property>
		</properties>
	</rule>

	<!-- Repositorios del plugin: consultas directas a tablas propias, sin
	     caché (son escrituras o listados de admin). -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>plugin/ddn-suite/inc/*Repository.php</exclude-pattern>
		<exclude-pattern>plugin/ddn-suite/inc/Install/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
